<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="AppBackgroundColor">#F4F7FB</Color>
    <Color x:Key="PanelColor">#FFFFFF</Color>
    <Color x:Key="PanelAltColor">#E8EEF7</Color>
    <Color x:Key="ControlSurfaceColor">#FFFFFF</Color>
    <Color x:Key="ControlSurfaceHoverColor">#EAF3FF</Color>
    <Color x:Key="ControlSurfacePressedColor">#DCEBFF</Color>
    <Color x:Key="ControlBorderColor">#66758A</Color>
    <Color x:Key="DropdownSurfaceColor">#FFFFFF</Color>
    <Color x:Key="DropdownSelectedColor">#245F9F</Color>
    <Color x:Key="FocusRingColor">#005FB8</Color>
    <Color x:Key="AccentColor">#0067C0</Color>
    <Color x:Key="AccentHoverColor">#005AAB</Color>
    <Color x:Key="AccentPressedColor">#004C91</Color>
    <Color x:Key="AccentTextColor">#FFFFFF</Color>
    <Color x:Key="SelectionTextColor">#FFFFFF</Color>
    <Color x:Key="TextPrimaryColor">#151A22</Color>
    <Color x:Key="TextSecondaryColor">#4D5A6A</Color>
    <Color x:Key="TextDisabledColor">#697386</Color>
    <Color x:Key="PlayerPlaceholderColor">#F0F4FA</Color>
    <Color x:Key="PlayerPlaceholderBorderColor">#66758A</Color>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="PanelAltBrush" Color="{StaticResource PanelAltColor}" />
    <SolidColorBrush x:Key="ControlSurfaceBrush" Color="{StaticResource ControlSurfaceColor}" />
    <SolidColorBrush x:Key="ControlSurfaceHoverBrush" Color="{StaticResource ControlSurfaceHoverColor}" />
    <SolidColorBrush x:Key="ControlSurfacePressedBrush" Color="{StaticResource ControlSurfacePressedColor}" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="{StaticResource ControlBorderColor}" />
    <SolidColorBrush x:Key="DropdownSurfaceBrush" Color="{StaticResource DropdownSurfaceColor}" />
    <SolidColorBrush x:Key="DropdownSelectedBrush" Color="{StaticResource DropdownSelectedColor}" />
    <SolidColorBrush x:Key="FocusRingBrush" Color="{StaticResource FocusRingColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColor}" />
    <SolidColorBrush x:Key="SelectionTextBrush" Color="{StaticResource SelectionTextColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}" />
    <SolidColorBrush x:Key="PlayerPlaceholderBrush" Color="{StaticResource PlayerPlaceholderColor}" />
    <SolidColorBrush x:Key="PlayerPlaceholderBorderBrush" Color="{StaticResource PlayerPlaceholderBorderColor}" />
</ResourceDictionary>



