<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="AppBackgroundColor">#101318</Color>
    <Color x:Key="PanelColor">#171B22</Color>
    <Color x:Key="PanelAltColor">#202633</Color>
    <Color x:Key="ControlSurfaceColor">#1D2633</Color>
    <Color x:Key="ControlSurfaceHoverColor">#263A55</Color>
    <Color x:Key="ControlSurfacePressedColor">#304463</Color>
    <Color x:Key="ControlBorderColor">#6F839D</Color>
    <Color x:Key="DropdownSurfaceColor">#111827</Color>
    <Color x:Key="DropdownSelectedColor">#2D6FB7</Color>
    <Color x:Key="FocusRingColor">#8CCBFF</Color>
    <Color x:Key="AccentColor">#58B7FF</Color>
    <Color x:Key="AccentHoverColor">#70C4FF</Color>
    <Color x:Key="AccentPressedColor">#2D86D8</Color>
    <Color x:Key="AccentTextColor">#06111D</Color>
    <Color x:Key="SelectionTextColor">#FFFFFF</Color>
    <Color x:Key="TextPrimaryColor">#F4F7FB</Color>
    <Color x:Key="TextSecondaryColor">#AEB8C6</Color>
    <Color x:Key="TextDisabledColor">#6F7A8A</Color>
    <Color x:Key="PlayerPlaceholderColor">#050607</Color>
    <Color x:Key="PlayerPlaceholderBorderColor">#6F839D</Color>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="PanelAltBrush" Color="{StaticResource PanelAltColor}" />
    <SolidColorBrush x:Key="ControlSurfaceBrush" Color="{StaticResource ControlSurfaceColor}" />
    <SolidColorBrush x:Key="ControlSurfaceHoverBrush" Color="{StaticResource ControlSurfaceHoverColor}" />
    <SolidColorBrush x:Key="ControlSurfacePressedBrush" Color="{StaticResource ControlSurfacePressedColor}" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="{StaticResource ControlBorderColor}" />
    <SolidColorBrush x:Key="DropdownSurfaceBrush" Color="{StaticResource DropdownSurfaceColor}" />
    <SolidColorBrush x:Key="DropdownSelectedBrush" Color="{StaticResource DropdownSelectedColor}" />
    <SolidColorBrush x:Key="FocusRingBrush" Color="{StaticResource FocusRingColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColor}" />
    <SolidColorBrush x:Key="SelectionTextBrush" Color="{StaticResource SelectionTextColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}" />
    <SolidColorBrush x:Key="PlayerPlaceholderBrush" Color="{StaticResource PlayerPlaceholderColor}" />
    <SolidColorBrush x:Key="PlayerPlaceholderBorderBrush" Color="{StaticResource PlayerPlaceholderBorderColor}" />
</ResourceDictionary>



