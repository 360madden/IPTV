<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="AppBackgroundColor">#000000</Color>
    <Color x:Key="PanelColor">#000000</Color>
    <Color x:Key="PanelAltColor">#101010</Color>
    <Color x:Key="ControlSurfaceColor">#000000</Color>
    <Color x:Key="ControlSurfaceHoverColor">#1A1A1A</Color>
    <Color x:Key="ControlSurfacePressedColor">#2A2A2A</Color>
    <Color x:Key="ControlBorderColor">#FFFFFF</Color>
    <Color x:Key="DropdownSurfaceColor">#000000</Color>
    <Color x:Key="DropdownSelectedColor">#005FEE</Color>
    <Color x:Key="FocusRingColor">#FFFF00</Color>
    <Color x:Key="AccentColor">#FFFF00</Color>
    <Color x:Key="AccentHoverColor">#FFE766</Color>
    <Color x:Key="AccentPressedColor">#FFCC00</Color>
    <Color x:Key="AccentTextColor">#000000</Color>
    <Color x:Key="SelectionTextColor">#FFFFFF</Color>
    <Color x:Key="TextPrimaryColor">#FFFFFF</Color>
    <Color x:Key="TextSecondaryColor">#E6E6E6</Color>
    <Color x:Key="TextDisabledColor">#B8B8B8</Color>
    <Color x:Key="DisabledControlSurfaceColor">#101010</Color>
    <Color x:Key="DisabledControlBorderColor">#B8B8B8</Color>
    <Color x:Key="PlayerPlaceholderColor">#000000</Color>
    <Color x:Key="PlayerPlaceholderBorderColor">#FFFF00</Color>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="PanelAltBrush" Color="{StaticResource PanelAltColor}" />
    <SolidColorBrush x:Key="ControlSurfaceBrush" Color="{StaticResource ControlSurfaceColor}" />
    <SolidColorBrush x:Key="ControlSurfaceHoverBrush" Color="{StaticResource ControlSurfaceHoverColor}" />
    <SolidColorBrush x:Key="ControlSurfacePressedBrush" Color="{StaticResource ControlSurfacePressedColor}" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="{StaticResource ControlBorderColor}" />
    <SolidColorBrush x:Key="DropdownSurfaceBrush" Color="{StaticResource DropdownSurfaceColor}" />
    <SolidColorBrush x:Key="DropdownSelectedBrush" Color="{StaticResource DropdownSelectedColor}" />
    <SolidColorBrush x:Key="FocusRingBrush" Color="{StaticResource FocusRingColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColor}" />
    <SolidColorBrush x:Key="SelectionTextBrush" Color="{StaticResource SelectionTextColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}" />
    <SolidColorBrush x:Key="DisabledControlSurfaceBrush" Color="{StaticResource DisabledControlSurfaceColor}" />
    <SolidColorBrush x:Key="DisabledControlBorderBrush" Color="{StaticResource DisabledControlBorderColor}" />
    <SolidColorBrush x:Key="PlayerPlaceholderBrush" Color="{StaticResource PlayerPlaceholderColor}" />
    <SolidColorBrush x:Key="PlayerPlaceholderBorderBrush" Color="{StaticResource PlayerPlaceholderBorderColor}" />
</ResourceDictionary>
