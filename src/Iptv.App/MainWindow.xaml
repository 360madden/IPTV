<Window x:Class="Iptv.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:persistence="clr-namespace:Iptv.Persistence;assembly=Iptv.Persistence"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="IPTV Viewer"
        Height="820"
        Width="1280"
        MinHeight="680"
        MinWidth="1040"
        Background="{StaticResource AppBackgroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Border x:Name="HeaderBar"
                Grid.Row="0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="#283243"
                BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="IPTV Viewer"
                               FontSize="26"
                               FontWeight="Bold" />
                    <TextBlock Text="Content-neutral playlist viewer — import your own M3U/M3U8 sources"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="13" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <CheckBox Content="Basic mode"
                              IsChecked="{Binding IsBasicMode}"
                              VerticalAlignment="Center"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              Margin="0,0,12,0"
                              AutomationProperties.Name="Basic Mode" />
                    <Button Content="Import File"
                            Command="{Binding ImportFileCommand}" />
                    <Button Content="Load Sample"
                            Command="{Binding LoadSampleCommand}" />
                    <Button Content="Refresh"
                            Command="{Binding RefreshPlaylistCommand}" />
                    <Button Content="Import XMLTV"
                            Command="{Binding ImportEpgCommand}" />
                    <Button Content="XMLTV URL"
                            Command="{Binding ImportEpgUrlCommand}"
                            AutomationProperties.Name="Import XMLTV URL" />
                    <Button Content="Import Org"
                            Command="{Binding ImportOrganizationCommand}" />
                    <Button Content="Export Org"
                            Command="{Binding ExportOrganizationCommand}" />
                    <Button Content="Import URL"
                            Background="{StaticResource AccentBrush}"
                            Command="{Binding ImportUrlCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="MainContentGrid"
              Grid.Row="1"
              Margin="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="390" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="LibraryPanel"
                    Background="{StaticResource PanelBrush}"
                    CornerRadius="14"
                    Padding="18"
                    Margin="0,0,14,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                    <TextBlock Text="Library"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Margin="0,0,0,18" />

                    <TextBlock Text="Search"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,6" />
                    <TextBox x:Name="SearchBox"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,14"
                             AutomationProperties.Name="Channel Search" />

                    <TextBlock Text="Recent playlists"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding RecentPlaylistSources}"
                              SelectedItem="{Binding SelectedRecentPlaylistSource}"
                              DisplayMemberPath="DisplayText"
                              Margin="0,0,0,8"
                              Padding="8"
                              Background="{StaticResource PanelAltBrush}"
                              Foreground="Black"
                              AutomationProperties.Name="Recent Playlist Sources" />
                    <TextBox Text="{Binding RecentPlaylistSourceName, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,8"
                             AutomationProperties.Name="Recent Playlist Source Name" />
                    <WrapPanel Margin="0,0,0,14">
                        <Button Content="Open Recent"
                                Command="{Binding OpenRecentPlaylistSourceCommand}"
                                Margin="0,0,8,8"
                                AutomationProperties.Name="Open Recent Playlist" />
                        <Button Content="Rename"
                                Command="{Binding RenameRecentPlaylistSourceCommand}"
                                Margin="0,0,8,8"
                                AutomationProperties.Name="Rename Recent Playlist" />
                        <Button Content="{Binding PinRecentPlaylistSourceLabel}"
                                Command="{Binding TogglePinRecentPlaylistSourceCommand}"
                                Margin="0,0,8,8"
                                AutomationProperties.Name="Pin Recent Playlist" />
                        <Button Content="Remove"
                                Command="{Binding RemoveRecentPlaylistSourceCommand}"
                                Margin="0,0,8,8"
                                AutomationProperties.Name="Remove Recent Playlist" />
                        <Button Content="Import List"
                                Command="{Binding ImportRecentPlaylistSourcesCommand}"
                                Margin="0,0,8,8"
                                AutomationProperties.Name="Import Recent Playlist Sources" />
                        <Button Content="Export List"
                                Command="{Binding ExportRecentPlaylistSourcesCommand}"
                                Margin="0,0,8,8"
                                AutomationProperties.Name="Export Recent Playlist Sources" />
                        <Button Content="Clear"
                                Command="{Binding ClearRecentPlaylistSourcesCommand}"
                                Margin="0,0,8,8"
                                AutomationProperties.Name="Clear Recent Playlists" />
                    </WrapPanel>

                    <TextBlock Text="Group"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding Groups}"
                              SelectedItem="{Binding SelectedGroup}"
                              Margin="0,0,0,14"
                              Padding="8"
                              Background="{StaticResource PanelAltBrush}"
                              Foreground="Black" />

                    <TextBlock Text="Category"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding SelectedCategory}"
                              Margin="0,0,0,14"
                              Padding="8"
                              Background="{StaticResource PanelAltBrush}"
                              Foreground="Black" />

                    <TextBlock Text="Content"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding ContentKindFilterOptions}"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding SelectedContentKind}"
                              Margin="0,0,0,14"
                              Padding="8"
                              Background="{StaticResource PanelAltBrush}"
                              Foreground="Black"
                              AutomationProperties.Name="Content Type Filter" />

                    <TextBlock Text="VOD / Series Year"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding VodYears}"
                              SelectedItem="{Binding SelectedVodYear}"
                              Margin="0,0,0,14"
                              Padding="8"
                              Background="{StaticResource PanelAltBrush}"
                              Foreground="Black"
                              AutomationProperties.Name="VOD Year Filter" />

                    <CheckBox Content="Favorites only"
                              IsChecked="{Binding FavoritesOnly}"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              Margin="0,4,0,12" />

                    <TextBlock Text="Visibility"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding VisibilityFilterOptions}"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding SelectedHiddenFilter}"
                              Margin="0,0,0,14"
                              Padding="8"
                              Background="{StaticResource PanelAltBrush}"
                              Foreground="Black"
                              AutomationProperties.Name="Channel Visibility Filter" />

                    <TextBlock Text="Sort"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding SortModeOptions}"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding SelectedSortMode}"
                              Margin="0,0,0,16"
                              Padding="8"
                              Background="{StaticResource PanelAltBrush}"
                              Foreground="Black"
                              AutomationProperties.Name="Channel Sort Mode" />

                    <TextBlock Text="Saved smart view"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding SmartViewOptions}"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding SelectedSmartView}"
                              Margin="0,0,0,16"
                              Padding="8"
                              Background="{StaticResource PanelAltBrush}"
                              Foreground="Black"
                              AutomationProperties.Name="Saved Smart View" />

                    <CheckBox Content="Large library mode"
                              IsChecked="{Binding LargeLibraryMode}"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              Margin="0,0,0,4"
                              AutomationProperties.Name="Large Library Mode" />
                    <TextBlock Text="{Binding VisibleResultLimitText}"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12"
                               Margin="0,0,0,12" />

                    <TextBlock Text="View density"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding ChannelViewDensityOptions}"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding SelectedChannelViewDensity}"
                              Padding="8"
                              Margin="0,0,0,14"
                              Background="{StaticResource PanelAltBrush}"
                              Foreground="Black"
                              AutomationProperties.Name="Channel View Density" />

                    <Button Content="Clear Filters"
                            Command="{Binding ClearFiltersCommand}"
                            Margin="0,0,0,18" />

                    <Expander Header="Channel Organization"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              Background="{StaticResource PanelAltBrush}"
                              Margin="0,0,0,14"
                              IsExpanded="True"
                              Visibility="{Binding IsAdvancedModeVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                              AutomationProperties.Name="Channel Organization">
                        <Border Background="{StaticResource PanelAltBrush}"
                                CornerRadius="10"
                                Padding="12"
                                Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="Custom groups"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8" />
                                <TextBlock Text="Add a group, then assign selected or batch-selected channels."
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,0,0,10" />
                                <TextBox Text="{Binding NewCustomGroupName, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,0,8"
                                         AutomationProperties.Name="New Custom Group Name" />
                                <Button Content="Add Group"
                                        Command="{Binding AddCustomGroupCommand}"
                                        Margin="0,0,0,12" />
                                <WrapPanel Margin="0,0,0,10">
                                    <Button Content="Import CSV"
                                            Command="{Binding ImportCustomGroupCsvCommand}"
                                            Margin="0,0,8,8"
                                            AutomationProperties.Name="Import Custom Group CSV" />
                                    <Button Content="Export CSV"
                                            Command="{Binding ExportCustomGroupCsvCommand}"
                                            Margin="0,0,8,8"
                                            AutomationProperties.Name="Export Custom Group CSV" />
                                </WrapPanel>
                                <ListBox ItemsSource="{Binding CustomGroupSummaries}"
                                         SelectedValuePath="Name"
                                         SelectedValue="{Binding SelectedManagedCustomGroup}"
                                         AllowDrop="True"
                                         MaxHeight="120"
                                         Background="Transparent"
                                         BorderBrush="#334056"
                                         Foreground="{StaticResource TextSecondaryBrush}"
                                         ScrollViewer.CanContentScroll="True"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         DragOver="CustomGroups_DragOver"
                                         Drop="CustomGroups_Drop"
                                         AutomationProperties.Name="Custom Group List">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel LastChildFill="True">
                                                <TextBlock Text="{Binding ChannelCount, StringFormat={}{0:N0}}"
                                                           DockPanel.Dock="Right"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           Margin="10,0,0,0" />
                                                <TextBlock Text="{Binding Name}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Text="Rename selected group"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,10,0,4" />
                                <TextBox Text="{Binding RenameCustomGroupName, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,0,8"
                                         AutomationProperties.Name="Rename Custom Group Name" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Rename"
                                            Command="{Binding RenameCustomGroupCommand}" />
                                    <Button Content="Delete"
                                            Command="{Binding DeleteCustomGroupCommand}" />
                                </StackPanel>
                                <TextBlock Text="{Binding BatchSelectionText}"
                                           FontWeight="SemiBold"
                                           Margin="0,14,0,6" />
                                <ComboBox ItemsSource="{Binding CustomGroupAssignments}"
                                          SelectedItem="{Binding SelectedBatchGroupAssignment}"
                                          Padding="6"
                                          Margin="0,0,0,8"
                                          Foreground="Black"
                                          AutomationProperties.Name="Batch Custom Group" />
                                <WrapPanel>
                                    <Button Content="Batch Favorite"
                                            Command="{Binding BatchFavoriteCommand}"
                                            Margin="0,0,8,8" />
                                    <Button Content="Batch Hide"
                                            Command="{Binding BatchHideCommand}"
                                            Margin="0,0,8,8" />
                                    <Button Content="Batch Unhide"
                                            Command="{Binding BatchUnhideCommand}"
                                            Margin="0,0,8,8" />
                                    <Button Content="Assign Group"
                                            Command="{Binding BatchAssignGroupCommand}"
                                            Margin="0,0,8,8" />
                                    <Button Content="Clear Group"
                                            Command="{Binding BatchClearGroupCommand}"
                                            Margin="0,0,8,8" />
                                </WrapPanel>
                                <Separator Margin="0,6,0,10" />
                                <TextBlock Text="Smart group rule"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,6" />
                                <TextBlock Text="Match by contains, starts-with, regex, group, or category. Apply preserves existing custom groups."
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,0,0,8" />
                                <TextBlock Text="Rule mode"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding SmartRuleMatchModeOptions}"
                                          DisplayMemberPath="Label"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding SelectedSmartRuleMatchMode}"
                                          Padding="6"
                                          Margin="0,0,0,8"
                                          Foreground="Black"
                                          AutomationProperties.Name="Smart Group Rule Mode" />
                                <TextBlock Text="Match text"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,0,0,4" />
                                <TextBox Text="{Binding SmartGroupMatchText, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,0,8"
                                         AutomationProperties.Name="Smart Group Match Text" />
                                <TextBlock Text="Destination group"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,0,0,4" />
                                <TextBox Text="{Binding SmartGroupName, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,0,8"
                                         AutomationProperties.Name="Smart Group Destination" />
                                <WrapPanel>
                                    <Button Content="Preview Rule"
                                            Command="{Binding PreviewSmartGroupCommand}"
                                            Margin="0,0,8,8" />
                                    <Button Content="Apply Rule"
                                            Command="{Binding ApplySmartGroupCommand}"
                                            Margin="0,0,8,8" />
                                    <Button Content="Undo"
                                            Command="{Binding UndoOrganizationActionCommand}"
                                            Margin="0,0,8,8" />
                                </WrapPanel>
                                <TextBlock Text="{Binding SmartGroupPreviewText}"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,0,0,8" />
                                <TextBlock Text="Preset name"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,0,0,4" />
                                <TextBox Text="{Binding SmartGroupPresetName, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,0,8"
                                         AutomationProperties.Name="Smart Group Preset Name" />
                                <WrapPanel>
                                    <Button Content="Save Preset"
                                            Command="{Binding SaveSmartGroupPresetCommand}"
                                            Margin="0,0,8,8" />
                                    <Button Content="Use Preset"
                                            Command="{Binding UseSmartGroupPresetCommand}"
                                            Margin="0,0,8,8" />
                                    <Button Content="Import Presets"
                                            Command="{Binding ImportSmartGroupPresetsCommand}"
                                            Margin="0,0,8,8" />
                                    <Button Content="Export Presets"
                                            Command="{Binding ExportSmartGroupPresetsCommand}"
                                            Margin="0,0,8,8" />
                                </WrapPanel>
                                <ListBox ItemsSource="{Binding SmartGroupPresets}"
                                         SelectedItem="{Binding SelectedSmartGroupPreset}"
                                         MaxHeight="100"
                                         Background="Transparent"
                                         BorderBrush="#334056"
                                         Foreground="{StaticResource TextSecondaryBrush}"
                                         ScrollViewer.CanContentScroll="True"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         AutomationProperties.Name="Smart Group Presets">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayText}"
                                                       TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Separator Margin="0,12,0,10" />
                                <TextBlock Text="Duplicate merge assistant"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,6" />
                                <TextBlock Text="{Binding DuplicateAssistantSummaryText}"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,0,0,8" />
                                <WrapPanel>
                                    <Button Content="Refresh Duplicates"
                                            Command="{Binding RefreshDuplicateGroupsCommand}"
                                            Margin="0,0,8,8" />
                                    <Button Content="Hide Duplicates"
                                            Command="{Binding HideSelectedDuplicateGroupCommand}"
                                            Margin="0,0,8,8"
                                            AutomationProperties.Name="Hide Duplicates" />
                                </WrapPanel>
                                <ListBox ItemsSource="{Binding DuplicateChannelGroups}"
                                         SelectedItem="{Binding SelectedDuplicateGroup}"
                                         MaxHeight="100"
                                         Background="Transparent"
                                         BorderBrush="#334056"
                                         Foreground="{StaticResource TextSecondaryBrush}"
                                         ScrollViewer.CanContentScroll="True"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         AutomationProperties.Name="Duplicate Channel Groups">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayText}"
                                                       TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Separator Margin="0,12,0,10" />
                                <TextBlock Text="Hidden / locked audit"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,6" />
                                <TextBlock Text="{Binding AuditSummaryText}"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,0,0,8" />
                                <WrapPanel>
                                    <Button Content="Refresh Audit"
                                            Command="{Binding RefreshAuditCommand}"
                                            Margin="0,0,8,8" />
                                    <Button Content="Unhide Group"
                                            Command="{Binding UnhideAuditGroupCommand}"
                                            Margin="0,0,8,8" />
                                    <Button Content="Unlock Group"
                                            Command="{Binding UnlockAuditGroupCommand}"
                                            Margin="0,0,8,8" />
                                </WrapPanel>
                                <ListBox ItemsSource="{Binding HiddenLockedAuditRows}"
                                         SelectedItem="{Binding SelectedAuditRow}"
                                         MaxHeight="110"
                                         Background="Transparent"
                                         BorderBrush="#334056"
                                         Foreground="{StaticResource TextSecondaryBrush}"
                                         ScrollViewer.CanContentScroll="True"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         AutomationProperties.Name="Hidden Locked Audit">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayText}"
                                                       TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Separator Margin="0,12,0,10" />
                                <TextBlock Text="Parental / PIN lock"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,6" />
                                <TextBlock Text="{Binding ParentalLockStatusText}"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,0,0,8" />
                                <PasswordBox x:Name="ParentalPinBox"
                                             MaxLength="12"
                                             Margin="0,0,0,8"
                                             AutomationProperties.Name="Parental PIN" />
                                <WrapPanel>
                                    <Button Content="Set PIN"
                                            Click="SetParentalPin_Click"
                                            Margin="0,0,8,8" />
                                    <Button Content="Unlock"
                                            Click="UnlockParentalPin_Click"
                                            Margin="0,0,8,8" />
                                    <Button Content="Lock Now"
                                            Command="{Binding LockParentalControlsCommand}"
                                            Margin="0,0,8,8" />
                                    <Button Content="Lock Group"
                                            Command="{Binding LockSelectedGroupCommand}"
                                            Margin="0,0,8,8" />
                                    <Button Content="Unlock Group"
                                            Command="{Binding UnlockSelectedGroupCommand}"
                                            Margin="0,0,8,8" />
                                    <Button Content="Clear PIN"
                                            Command="{Binding ClearParentalPinCommand}"
                                            Margin="0,0,8,8" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </Expander>

                    <Expander Header="Source Profiles"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              Background="{StaticResource PanelAltBrush}"
                              Margin="0,0,0,14"
                              IsExpanded="False"
                              Visibility="{Binding IsAdvancedModeVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                              AutomationProperties.Name="Source Profiles">
                        <Border Background="{StaticResource PanelAltBrush}"
                                CornerRadius="10"
                                Padding="12"
                                Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="Rename provider/source profiles without changing stream URLs or channel IDs."
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,0,0,8" />
                                <ListBox ItemsSource="{Binding SourceProfiles}"
                                         SelectedItem="{Binding SelectedSourceProfile}"
                                         DisplayMemberPath="DisplayText"
                                         MaxHeight="100"
                                         Background="Transparent"
                                         BorderBrush="#334056"
                                         Foreground="{StaticResource TextSecondaryBrush}"
                                         AutomationProperties.Name="Source Profile List" />
                                <TextBox Text="{Binding RenameSourceProfileName, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,8,0,8"
                                         AutomationProperties.Name="Rename Source Profile" />
                                <Button Content="Rename Profile"
                                        Command="{Binding RenameSourceProfileCommand}"
                                        Margin="0,0,0,12" />
                                <TextBlock Text="Playback fallback"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,6" />
                                <TextBlock Text="Provider profile applies buffer preset and startup retries before playback."
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,0,0,8" />
                                <TextBlock Text="Retries"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding RetryCountOptions}"
                                          SelectedItem="{Binding SelectedSourceRetryCount}"
                                          Padding="6"
                                          Margin="0,0,0,8"
                                          Foreground="Black"
                                          AutomationProperties.Name="Source Retry Count" />
                                <TextBlock Text="Buffer preset"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding BufferingPresets}"
                                          SelectedItem="{Binding SelectedSourceBufferingPreset}"
                                          Padding="6"
                                          Margin="0,0,0,8"
                                          Foreground="Black"
                                          AutomationProperties.Name="Source Buffer Preset" />
                                <Button Content="Save Playback Profile"
                                        Command="{Binding SaveSourcePlaybackProfileCommand}"
                                        Margin="0,0,0,12" />
                                <WrapPanel Margin="0,0,0,12">
                                    <Button Content="Import Profiles"
                                            Command="{Binding ImportSourceProfilesCommand}"
                                            Margin="0,0,8,8"
                                            AutomationProperties.Name="Import Source Profiles" />
                                    <Button Content="Export Profiles"
                                            Command="{Binding ExportSourceProfilesCommand}"
                                            Margin="0,0,8,8"
                                            AutomationProperties.Name="Export Source Profiles" />
                                </WrapPanel>
                                <TextBlock Text="Default group visibility"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,6" />
                                <TextBlock Text="{Binding SourceDefaultVisibilitySummaryText}"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,0,0,8" />
                                <ComboBox ItemsSource="{Binding SourceDefaultVisibilityGroups}"
                                          SelectedItem="{Binding SelectedSourceDefaultVisibilityGroup}"
                                          Padding="6"
                                          Margin="0,0,0,8"
                                          Foreground="Black"
                                          AutomationProperties.Name="Source Default Visibility Group" />
                                <WrapPanel Margin="0,0,0,12">
                                    <Button Content="Hide By Default"
                                            Command="{Binding HideSourceDefaultGroupCommand}"
                                            Margin="0,0,8,8"
                                            AutomationProperties.Name="Hide Source Group By Default" />
                                    <Button Content="Show By Default"
                                            Command="{Binding ShowSourceDefaultGroupCommand}"
                                            Margin="0,0,8,8"
                                            AutomationProperties.Name="Show Source Group By Default" />
                                </WrapPanel>
                                <TextBlock Text="Refresh schedule"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,6" />
                                <CheckBox Content="Enable manual refresh reminders"
                                          IsChecked="{Binding RefreshScheduleEnabled}"
                                          Foreground="{StaticResource TextPrimaryBrush}"
                                          Margin="0,0,0,8"
                                          AutomationProperties.Name="Enable Refresh Schedule" />
                                <ComboBox ItemsSource="{Binding RefreshIntervalMinuteOptions}"
                                          SelectedItem="{Binding SelectedRefreshIntervalMinutes}"
                                          Padding="6"
                                          Margin="0,0,0,8"
                                          Foreground="Black"
                                          AutomationProperties.Name="Refresh Interval Minutes" />
                                <TextBlock Text="{Binding RefreshScheduleStatusText}"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,0,0,12" />
                                <TextBlock Text="XMLTV URL"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,6" />
                                <TextBox Text="{Binding XmltvGuideUrl, UpdateSourceTrigger=PropertyChanged, Delay=500}"
                                         Margin="0,0,0,8"
                                         AutomationProperties.Name="XMLTV Guide URL" />
                                <CheckBox Content="Auto-load XMLTV after playlist import"
                                          IsChecked="{Binding AutoLoadXmltvOnPlaylistImport}"
                                          Foreground="{StaticResource TextPrimaryBrush}"
                                          Margin="0,0,0,8"
                                          AutomationProperties.Name="Auto Load XMLTV" />
                                <Button Content="Import XMLTV URL"
                                        Command="{Binding ImportEpgUrlCommand}"
                                        HorizontalAlignment="Left"
                                        AutomationProperties.Name="Import XMLTV URL From Settings" />
                            </StackPanel>
                        </Border>
                    </Expander>

                    <Expander Header="UI Settings"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              Background="{StaticResource PanelAltBrush}"
                              Margin="0,0,0,14"
                              IsExpanded="False"
                              AutomationProperties.Name="UI Settings">
                        <Border Background="{StaticResource PanelAltBrush}"
                                CornerRadius="10"
                                Padding="12"
                                Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="Clock overlay"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8" />
                                <CheckBox Content="Show clock"
                                          IsChecked="{Binding Clock.IsVisible}"
                                          Foreground="{StaticResource TextPrimaryBrush}"
                                          Margin="0,0,0,6"
                                          AutomationProperties.Name="Show Clock" />
                                <CheckBox Content="Use 24-hour time"
                                          IsChecked="{Binding Clock.Use24HourClock}"
                                          Foreground="{StaticResource TextPrimaryBrush}"
                                          Margin="0,0,0,6"
                                          AutomationProperties.Name="Use 24 Hour Clock" />
                                <CheckBox Content="Show seconds"
                                          IsChecked="{Binding Clock.ShowSeconds}"
                                          Foreground="{StaticResource TextPrimaryBrush}"
                                          Margin="0,0,0,12"
                                          AutomationProperties.Name="Show Clock Seconds" />

                                <TextBlock Text="Position"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding Clock.PositionOptions}"
                                          DisplayMemberPath="Label"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding Clock.Position}"
                                          Padding="6"
                                          Margin="0,0,0,10"
                                          Foreground="Black"
                                          AutomationProperties.Name="Clock Position" />

                                <TextBlock Text="Size"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding Clock.SizeOptions}"
                                          DisplayMemberPath="Label"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding Clock.Size}"
                                          Padding="6"
                                          Margin="0,0,0,10"
                                          Foreground="Black"
                                          AutomationProperties.Name="Clock Size" />

                                <TextBlock Text="Background"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding Clock.BackgroundOptions}"
                                          DisplayMemberPath="Label"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding Clock.Background}"
                                          Padding="6"
                                          Margin="0,0,0,10"
                                          Foreground="Black"
                                          AutomationProperties.Name="Clock Background" />

                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="Opacity"
                                               DockPanel.Dock="Left"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding Clock.OverlayOpacityPercent}"
                                               DockPanel.Dock="Right"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Right" />
                                </DockPanel>
                                <Slider Minimum="0.35"
                                        Maximum="1"
                                        TickFrequency="0.05"
                                        Value="{Binding Clock.OverlayOpacity, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                        Margin="0,0,0,12"
                                        AutomationProperties.Name="Clock Opacity" />

                                <TextBlock Text="Fullscreen"
                                           FontWeight="SemiBold"
                                           Margin="0,2,0,8" />
                                <CheckBox Content="Auto-hide fullscreen controls"
                                          IsChecked="{Binding Clock.AutoHideFullscreenControls}"
                                          Foreground="{StaticResource TextPrimaryBrush}"
                                          Margin="0,0,0,8"
                                          AutomationProperties.Name="Auto Hide Fullscreen Controls" />

                                <TextBlock Text="Monitor"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding Clock.FullscreenMonitorOptions}"
                                          DisplayMemberPath="DisplayName"
                                          SelectedValuePath="Index"
                                          SelectedValue="{Binding Clock.FullscreenMonitorIndex}"
                                          Padding="6"
                                          Margin="0,0,0,12"
                                          Foreground="Black"
                                          AutomationProperties.Name="Fullscreen Monitor" />

                                <TextBlock Text="Logo cache"
                                           FontWeight="SemiBold"
                                           Margin="0,2,0,8" />
                                <TextBlock Text="{Binding LogoCacheStatusText}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,8" />
                                <ComboBox ItemsSource="{Binding LogoCacheLimitMegabyteOptions}"
                                          SelectedItem="{Binding SelectedLogoCacheLimitMegabytes}"
                                          Padding="6"
                                          Margin="0,0,0,8"
                                          Foreground="Black"
                                          AutomationProperties.Name="Logo Cache Limit" />
                                <WrapPanel>
                                    <Button Content="Trim Logo Cache"
                                            Command="{Binding TrimLogoCacheCommand}"
                                            Margin="0,0,8,8"
                                            AutomationProperties.Name="Trim Logo Cache" />
                                    <Button Content="Clear Logo Cache"
                                            Command="{Binding ClearLogoCacheCommand}"
                                            Margin="0,0,8,8"
                                            AutomationProperties.Name="Clear Logo Cache" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </Expander>

                    <Border Background="{StaticResource PanelAltBrush}"
                            CornerRadius="10"
                            Padding="12"
                            Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Import Summary"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6" />
                            <TextBlock Text="{Binding ImportSummaryText}"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding RefreshDiffText}"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding ProfileSummaryText}"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding ReconciliationText}"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <Expander Header="{Binding LibraryHealthSummaryText}"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      Background="{StaticResource PanelAltBrush}"
                                      Margin="0,8,0,0"
                                      IsExpanded="False"
                                      Visibility="{Binding IsAdvancedModeVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      AutomationProperties.Name="Library Health Dashboard">
                                <ListBox ItemsSource="{Binding LibraryHealthMetrics}"
                                         MaxHeight="160"
                                         Background="Transparent"
                                         BorderBrush="#334056"
                                         Foreground="{StaticResource TextSecondaryBrush}"
                                         ScrollViewer.CanContentScroll="True"
                                         VirtualizingPanel.IsVirtualizing="True">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayText}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,6" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Expander>
                            <TextBlock Text="{Binding ConflictReviewText}"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <Button Content="Clear Removed State"
                                    Command="{Binding ClearRemovedConflictStatesCommand}"
                                    Margin="0,8,0,0" />
                            <Expander Header="{Binding PendingRefreshSummaryText}"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      Background="{StaticResource PanelAltBrush}"
                                      Margin="0,8,0,0"
                                      IsExpanded="False"
                                      Visibility="{Binding IsAdvancedModeVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      AutomationProperties.Name="Refresh Approval">
                                <StackPanel>
                                    <WrapPanel Margin="0,6,0,8">
                                        <Button Content="Apply Refresh"
                                                Command="{Binding ApplyPendingRefreshCommand}"
                                                Margin="0,0,8,8" />
                                        <Button Content="Discard Refresh"
                                                Command="{Binding DiscardPendingRefreshCommand}"
                                                Margin="0,0,8,8" />
                                    </WrapPanel>
                                    <ListBox ItemsSource="{Binding PendingRefreshChanges}"
                                             MaxHeight="110"
                                             Background="Transparent"
                                             BorderBrush="#334056"
                                             Foreground="{StaticResource TextSecondaryBrush}"
                                             ScrollViewer.CanContentScroll="True"
                                             VirtualizingPanel.IsVirtualizing="True"
                                             AutomationProperties.Name="Refresh Approval Changes">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayText}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,0,0,6" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Expander>
                            <ListBox ItemsSource="{Binding RefreshConflicts}"
                                     MaxHeight="110"
                                     Margin="0,8,0,0"
                                     Background="Transparent"
                                     BorderBrush="#334056"
                                     Foreground="{StaticResource TextSecondaryBrush}"
                                     ScrollViewer.CanContentScroll="True"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     AutomationProperties.Name="Refresh Conflict Review">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayText}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,6" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="{Binding EpgSummaryText}"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <Expander Header="{Binding EpgTimelineSummaryText}"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      Background="{StaticResource PanelAltBrush}"
                                      Margin="0,8,0,0"
                                      IsExpanded="False"
                                      Visibility="{Binding IsAdvancedModeVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      AutomationProperties.Name="EPG Timeline">
                                <StackPanel>
                                    <ComboBox ItemsSource="{Binding EpgTimelineWindowOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding SelectedEpgTimelineWindow}"
                                              Width="150"
                                              HorizontalAlignment="Left"
                                              Padding="6"
                                              Margin="0,6,0,8"
                                              Foreground="Black"
                                              AutomationProperties.Name="EPG Timeline Window" />
                                    <TextBox Text="{Binding EpgSearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                                             Margin="0,0,0,8"
                                             AutomationProperties.Name="EPG Search"
                                             ToolTip="Search EPG titles and descriptions" />
                                    <DataGrid ItemsSource="{Binding EpgTimelineRows}"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              MaxHeight="180"
                                              Background="{StaticResource PanelAltBrush}"
                                              Foreground="{StaticResource TextPrimaryBrush}"
                                              BorderBrush="#334056"
                                              EnableRowVirtualization="True"
                                              EnableColumnVirtualization="True"
                                              VirtualizingPanel.IsVirtualizing="True"
                                              VirtualizingPanel.VirtualizationMode="Recycling">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Channel"
                                                                Binding="{Binding ChannelName}"
                                                                Width="2*" />
                                            <DataGridTextColumn Header="Now"
                                                                Binding="{Binding NowTitle}"
                                                                Width="2*" />
                                            <DataGridTextColumn Header="Next"
                                                                Binding="{Binding NextTitle}"
                                                                Width="2*" />
                                            <DataGridTextColumn Header="Later"
                                                                Binding="{Binding LaterTitle}"
                                                                Width="2*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Expander>
                            <Expander Header="{Binding SearchBenchmarkSummaryText}"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      Background="{StaticResource PanelAltBrush}"
                                      Margin="0,8,0,0"
                                      IsExpanded="False"
                                      Visibility="{Binding IsAdvancedModeVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      AutomationProperties.Name="Search Benchmark">
                                <StackPanel>
                                    <Button Content="Run Search Benchmark"
                                            Command="{Binding RunSearchBenchmarkCommand}"
                                            HorizontalAlignment="Left"
                                            Margin="0,6,0,8" />
                                    <ListBox ItemsSource="{Binding SearchBenchmarkResults}"
                                             MaxHeight="110"
                                             Background="Transparent"
                                             BorderBrush="#334056"
                                             Foreground="{StaticResource TextSecondaryBrush}"
                                             ScrollViewer.CanContentScroll="True"
                                             VirtualizingPanel.IsVirtualizing="True"
                                             AutomationProperties.Name="Search Benchmark Results">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayText}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,0,0,6" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource PanelAltBrush}"
                            CornerRadius="10"
                            Padding="12">
                        <StackPanel>
                            <TextBlock Text="Privacy"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6" />
                            <TextBlock Text="Raw stream URLs are hidden from normal UI and diagnostics. No playlists are bundled."
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Recent Import Issues"
                               FontWeight="SemiBold"
                               Margin="0,18,0,8" />
                    <ListBox ItemsSource="{Binding RecentImportIssues}"
                             MaxHeight="180"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{StaticResource TextSecondaryBrush}"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayText}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,8"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border x:Name="ChannelsPanel"
                    Grid.Column="1"
                    Background="{StaticResource PanelBrush}"
                    CornerRadius="14"
                    Padding="12"
                    Margin="0,0,14,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Margin="6,4,0,12">
                        <WrapPanel DockPanel.Dock="Right">
                            <Button Content="Select All Visible"
                                    Click="SelectAllVisible_Click"
                                    Padding="10,5"
                                    Margin="0,0,8,0"
                                    AutomationProperties.Name="Select All Visible Channels" />
                            <Button Content="Clear Selection"
                                    Click="ClearSelection_Click"
                                    Padding="10,5"
                                    Margin="0,0,8,0"
                                    AutomationProperties.Name="Clear Channel Selection" />
                            <Button Content="Prefetch Logos"
                                    Command="{Binding PrefetchVisibleLogosCommand}"
                                    Padding="10,5"
                                    AutomationProperties.Name="Prefetch Visible Logos" />
                        </WrapPanel>
                        <TextBlock Text="Channels"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                    </DockPanel>

                    <ListBox x:Name="ChannelsListBox"
                             Grid.Row="1"
                             ItemsSource="{Binding VisibleChannels}"
                             SelectedItem="{Binding SelectedChannel}"
                             SelectionMode="Extended"
                             AllowDrop="True"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             PreviewMouseLeftButtonDown="Channels_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="Channels_PreviewMouseMove"
                             DragOver="Channels_DragOver"
                             Drop="Channels_Drop"
                             SelectionChanged="Channels_SelectionChanged"
                             MouseDoubleClick="Channels_MouseDoubleClick">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,6" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource PanelAltBrush}"
                                        CornerRadius="10">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Padding" Value="12" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.SelectedChannelViewDensity, RelativeSource={RelativeSource AncestorType=Window}}"
                                                             Value="{x:Static persistence:ChannelViewDensity.Compact}">
                                                    <Setter Property="Padding" Value="8" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DataContext.SelectedChannelViewDensity, RelativeSource={RelativeSource AncestorType=Window}}"
                                                             Value="{x:Static persistence:ChannelViewDensity.Dense}">
                                                    <Setter Property="Padding" Value="6" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DataContext.LargeLibraryMode, RelativeSource={RelativeSource AncestorType=Window}}"
                                                             Value="True">
                                                    <Setter Property="Padding" Value="8" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontSize" Value="15" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DataContext.SelectedChannelViewDensity, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                         Value="{x:Static persistence:ChannelViewDensity.Dense}">
                                                                <Setter Property="FontSize" Value="13" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding EffectiveGroupTitle}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Category}"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontSize="12">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.SelectedChannelViewDensity, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                             Value="{x:Static persistence:ChannelViewDensity.Dense}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding ContentKind}"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontSize="12"
                                                           Margin="8,0,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1"
                                                    HorizontalAlignment="Right">
                                            <Border Background="{StaticResource AccentBrush}"
                                                    CornerRadius="8"
                                                    Padding="7,3"
                                                    Margin="0,0,0,6">
                                                <Border.Visibility>
                                                    <MultiBinding Converter="{StaticResource NowPlayingVisibilityConverter}">
                                                        <Binding Path="Id" />
                                                        <Binding Path="DataContext.NowPlayingChannelId"
                                                                 RelativeSource="{RelativeSource AncestorType=Window}" />
                                                    </MultiBinding>
                                                </Border.Visibility>
                                                <TextBlock Text="NOW"
                                                           Foreground="#071018"
                                                           FontSize="11"
                                                           FontWeight="Bold" />
                                            </Border>
                                            <TextBlock Text="★"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       FontSize="18"
                                                       HorizontalAlignment="Right"
                                                       Visibility="{Binding IsFavorite, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <Border Background="#664EA7FF"
                                                    CornerRadius="8"
                                                    Padding="7,3"
                                                    Margin="0,6,0,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding TvgLogo}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding TvgLogo}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="LOGO"
                                                           Foreground="#EAF2FF"
                                                           FontSize="11"
                                                           FontWeight="Bold" />
                                            </Border>
                                            <Border Background="#66FFB04E"
                                                    CornerRadius="8"
                                                    Padding="7,3"
                                                    Margin="0,6,0,0"
                                                    Visibility="{Binding IsHidden, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="HIDDEN"
                                                           Foreground="#FFF7E4"
                                                           FontSize="11"
                                                           FontWeight="Bold" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="2"
                                Margin="6,8,6,0">
                        <TextBlock Text="{Binding LogoPrefetchStatusText}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" />
                        <Expander Header="{Binding VodLibrarySummaryText}"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  Background="{StaticResource PanelAltBrush}"
                                  Margin="0,8,0,0"
                                  IsExpanded="False"
                                  Visibility="{Binding IsAdvancedModeVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  AutomationProperties.Name="VOD Library">
                            <StackPanel>
                                <WrapPanel Margin="0,6,0,8">
                                    <Button Content="Previous"
                                            Command="{Binding PreviousVodPageCommand}"
                                            Margin="0,0,8,8" />
                                    <Button Content="Next"
                                            Command="{Binding NextVodPageCommand}"
                                            Margin="0,0,8,8" />
                                </WrapPanel>
                                <ListBox ItemsSource="{Binding VodLibraryItems}"
                                         SelectedItem="{Binding SelectedVodLibraryItem}"
                                         MaxHeight="260"
                                         Background="Transparent"
                                         BorderBrush="#334056"
                                         Foreground="{StaticResource TextSecondaryBrush}"
                                         ScrollViewer.CanContentScroll="True"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling"
                                         AutomationProperties.Name="VOD Poster Grid">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel IsItemsHost="True" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="152"
                                                    MinHeight="220"
                                                    Margin="0,0,10,10"
                                                    Padding="8"
                                                    CornerRadius="8"
                                                    Background="#111827">
                                                <StackPanel>
                                                    <Border Height="128"
                                                            CornerRadius="6"
                                                            Background="#050607"
                                                            ClipToBounds="True">
                                                        <Image Source="{Binding PosterPath}"
                                                               Stretch="UniformToFill" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Title}"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap"
                                                               Margin="0,8,0,3" />
                                                    <TextBlock Text="{Binding ResumeText}"
                                                               Foreground="{StaticResource AccentBrush}"
                                                               FontSize="12" />
                                                    <TextBlock Text="{Binding GroupName}"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               TextWrapping="Wrap"
                                                               FontSize="11" />
                                                    <TextBlock Text="{Binding PosterStatusText}"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               TextWrapping="Wrap"
                                                               FontSize="11" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="PlayerPanel"
                    Grid.Column="2"
                    Background="{StaticResource PanelBrush}"
                    CornerRadius="14"
                    Padding="16">
                <Grid x:Name="PlayerContentGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="PlayerVideoRow"
                                       Height="*" />
                        <RowDefinition x:Name="PlayerDetailsRow"
                                       Height="Auto" />
                        <RowDefinition x:Name="PlayerControlsRow"
                                       Height="Auto" />
                        <RowDefinition x:Name="PlayerDiagnosticsRow"
                                       Height="170" />
                    </Grid.RowDefinitions>

                    <Border x:Name="PlayerVideoHost"
                            Background="#050607"
                            CornerRadius="12"
                            ClipToBounds="True">
                        <vlc:VideoView x:Name="PlayerView">
                            <Grid x:Name="PlayerOverlayGrid"
                                  Background="#01000000"
                                  MouseLeftButtonDown="PlayerOverlay_MouseLeftButtonDown"
                                  MouseMove="PlayerOverlay_MouseMove">
                                <Border Padding="{Binding Clock.OverlayPadding}"
                                        Background="{Binding Clock.OverlayBackgroundBrush}"
                                        BorderBrush="{Binding Clock.OverlayBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{Binding Clock.OverlayCornerRadius}"
                                        IsHitTestVisible="False"
                                        Opacity="{Binding Clock.OverlayOpacity}"
                                        Visibility="{Binding Clock.IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        AutomationProperties.Name="Clock Overlay">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                            <Setter Property="VerticalAlignment" Value="Top" />
                                            <Setter Property="Margin" Value="22,22,22,22" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Clock.Position}" Value="{x:Static persistence:ClockOverlayPosition.TopLeft}">
                                                    <Setter Property="HorizontalAlignment" Value="Left" />
                                                    <Setter Property="VerticalAlignment" Value="Top" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Clock.Position}" Value="{x:Static persistence:ClockOverlayPosition.BottomRight}">
                                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                                    <Setter Property="VerticalAlignment" Value="Bottom" />
                                                    <Setter Property="Margin" Value="22,22,22,118" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Clock.Position}" Value="{x:Static persistence:ClockOverlayPosition.BottomLeft}">
                                                    <Setter Property="HorizontalAlignment" Value="Left" />
                                                    <Setter Property="VerticalAlignment" Value="Bottom" />
                                                    <Setter Property="Margin" Value="22,22,22,118" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Clock.CurrentTime}"
                                               AutomationProperties.Name="{Binding Clock.CurrentTime, StringFormat=Clock Overlay {0}}"
                                               FontSize="{Binding Clock.FontSize}"
                                               FontWeight="SemiBold"
                                               Foreground="#FFFFFFFF"
                                               TextOptions.TextFormattingMode="Display"
                                               TextOptions.TextRenderingMode="ClearType" />
                                </Border>

                                <Border x:Name="FullscreenHudOverlay"
                                        VerticalAlignment="Bottom"
                                        HorizontalAlignment="Center"
                                        MaxWidth="860"
                                        Margin="24,0,24,28"
                                        Padding="18,14"
                                        Background="#D40A0E14"
                                        BorderBrush="#334EA7FF"
                                        BorderThickness="1"
                                        CornerRadius="18"
                                        Visibility="Collapsed"
                                        AutomationProperties.Name="Fullscreen Mini HUD">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SelectedChannel.DisplayName, FallbackValue=No channel selected}"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding PlaybackStatusText}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,4,0,0" />
                                            <TextBlock Text="F11 or double-click exits fullscreen · Esc restores window"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="11"
                                                       Margin="0,6,0,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                    Margin="18,0,0,0">
                                            <Button Content="Play"
                                                    Command="{Binding PlaySelectedCommand}" />
                                            <Button Content="Pause"
                                                    Command="{Binding PauseCommand}" />
                                            <Button Content="Stop"
                                                    Command="{Binding StopCommand}" />
                                            <Button Content="Exit"
                                                    Click="FullscreenExit_Click"
                                                    Background="{StaticResource AccentBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </vlc:VideoView>
                    </Border>

                    <StackPanel x:Name="PlayerDetailsPanel"
                                Grid.Row="1"
                                Margin="0,14,0,10">
                        <TextBlock Text="{Binding SelectedChannel.DisplayName, FallbackValue=No channel selected}"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding PlaybackStatusText}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding PlaybackProgressText}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"
                                   AutomationProperties.Name="Playback Progress" />
                        <TextBlock Text="{Binding SelectedChannelDetails}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap" />
                        <DockPanel Margin="0,8,0,0">
                            <Border DockPanel.Dock="Left"
                                    Width="64"
                                    Height="42"
                                    CornerRadius="6"
                                    Background="{StaticResource PanelAltBrush}"
                                    Margin="0,0,10,0"
                                    ClipToBounds="True">
                                <Image Source="{Binding SelectedChannelLogoPath}"
                                       Stretch="Uniform">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedChannelLogoPath}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedChannelLogoPath}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                            </Border>
                            <TextBlock Text="{Binding SelectedChannelLogoStatusText}"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </DockPanel>
                        <Expander Header="Channel details"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  Background="{StaticResource PanelAltBrush}"
                                  Margin="0,8,0,0"
                                  IsExpanded="False">
                            <Border Background="{StaticResource PanelAltBrush}"
                                    CornerRadius="8"
                                    Padding="10"
                                    Margin="0,6,0,0">
                                <TextBlock Text="{Binding SelectedChannelMetadataText}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </Border>
                        </Expander>
                        <Expander Header="{Binding FallbackSummaryText}"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  Background="{StaticResource PanelAltBrush}"
                                  Margin="0,8,0,0"
                                  IsExpanded="False"
                                  Visibility="{Binding IsAdvancedModeVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  AutomationProperties.Name="Fallback Streams">
                            <Border Background="{StaticResource PanelAltBrush}"
                                    CornerRadius="8"
                                    Padding="10"
                                    Margin="0,6,0,0">
                                <StackPanel>
                                    <Button Content="Play Fallback"
                                            Command="{Binding PlaySelectedFallbackCommand}"
                                            HorizontalAlignment="Left"
                                            Margin="0,0,0,8" />
                                    <ListBox ItemsSource="{Binding ChannelFallbacks}"
                                             SelectedItem="{Binding SelectedChannelFallback}"
                                             MaxHeight="120"
                                             Background="Transparent"
                                             BorderBrush="#334056"
                                             Foreground="{StaticResource TextSecondaryBrush}"
                                             ScrollViewer.CanContentScroll="True"
                                             VirtualizingPanel.IsVirtualizing="True"
                                             AutomationProperties.Name="Fallback Stream List">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayText}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,0,0,6" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>
                        </Expander>
                        <Expander Header="VOD / Series details"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  Background="{StaticResource PanelAltBrush}"
                                  Margin="0,8,0,0"
                                  IsExpanded="False"
                                  Visibility="{Binding IsAdvancedModeVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  AutomationProperties.Name="VOD Detail Page">
                            <Border Background="{StaticResource PanelAltBrush}"
                                    CornerRadius="8"
                                    Padding="10"
                                    Margin="0,6,0,0">
                                <DockPanel LastChildFill="True">
                                    <Border DockPanel.Dock="Left"
                                            Width="110"
                                            Height="160"
                                            CornerRadius="8"
                                            Background="#111827"
                                            Margin="0,0,12,0"
                                            ClipToBounds="True">
                                        <Image Source="{Binding SelectedChannelLogoPath}"
                                               Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="{Binding SelectedVodDetailText}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding ResumeProgressText}"
                                                   FontWeight="SemiBold"
                                                   Margin="0,8,0,6" />
                                        <WrapPanel>
                                            <Button Content="25%"
                                                    Command="{Binding SetResume25Command}"
                                                    Margin="0,0,8,8" />
                                            <Button Content="50%"
                                                    Command="{Binding SetResume50Command}"
                                                    Margin="0,0,8,8" />
                                            <Button Content="75%"
                                                    Command="{Binding SetResume75Command}"
                                                    Margin="0,0,8,8" />
                                            <Button Content="Clear Resume"
                                                    Command="{Binding ClearResumeCommand}"
                                                    Margin="0,0,8,8" />
                                        </WrapPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </Expander>
                        <Expander Header="EPG guide"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  Background="{StaticResource PanelAltBrush}"
                                  Margin="0,8,0,0"
                                  IsExpanded="False">
                            <ListBox ItemsSource="{Binding SelectedChannelEpgPrograms}"
                                     MaxHeight="120"
                                     Margin="0,6,0,0"
                                     Background="{StaticResource PanelAltBrush}"
                                     BorderBrush="#334056"
                                     Foreground="{StaticResource TextSecondaryBrush}"
                                     ScrollViewer.CanContentScroll="True"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     AutomationProperties.Name="Selected Channel EPG">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayText}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,6" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Expander>
                    </StackPanel>

                    <Grid x:Name="PlayerControlsPanel"
                          Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Play"
                                    Command="{Binding PlaySelectedCommand}" />
                            <Button Content="Pause"
                                    Command="{Binding PauseCommand}" />
                            <Button Content="Stop"
                                    Command="{Binding StopCommand}" />
                            <Button Content="Favorite"
                                    Command="{Binding ToggleFavoriteCommand}" />
                            <Button Content="{Binding HideSelectedChannelLabel}"
                                    Command="{Binding ToggleHiddenCommand}" />
                            <Button Content="Up"
                                    Command="{Binding MoveChannelUpCommand}" />
                            <Button Content="Down"
                                    Command="{Binding MoveChannelDownCommand}" />
                            <Button Content="Undo Org"
                                    Command="{Binding UndoOrganizationActionCommand}" />
                            <CheckBox Content="Clock"
                                      IsChecked="{Binding Clock.IsVisible}"
                                      VerticalAlignment="Center"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      Margin="6,0,10,0"
                                      AutomationProperties.Name="Player Clock" />
                            <CheckBox Content="24h"
                                      IsChecked="{Binding Clock.Use24HourClock}"
                                      VerticalAlignment="Center"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      Margin="0,0,10,0" />
                            <CheckBox Content="Sec"
                                      IsChecked="{Binding Clock.ShowSeconds}"
                                      VerticalAlignment="Center"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      Margin="0,0,10,0" />
                            <Button Content="Fullscreen"
                                    Click="Fullscreen_Click" />
                        </StackPanel>

                        <StackPanel Grid.Row="0"
                                    Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Buffer"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,10,0" />
                            <ComboBox Width="130"
                                      ItemsSource="{Binding BufferingPresets}"
                                      SelectedItem="{Binding SelectedBufferingPreset}"
                                      Margin="0,0,18,0"
                                      Padding="6"
                                      Foreground="Black" />
                            <TextBlock Text="Volume"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,10,0" />
                            <Slider Width="160"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="{Binding Volume, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    Grid.ColumnSpan="3"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="0,10,0,0">
                            <TextBlock Text="Selected group"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,10,0" />
                            <ComboBox Width="180"
                                      ItemsSource="{Binding CustomGroupAssignments}"
                                      SelectedItem="{Binding SelectedCustomGroupAssignment}"
                                      Padding="6"
                                      Margin="0,0,8,0"
                                      Foreground="Black"
                                      AutomationProperties.Name="Selected Channel Custom Group" />
                            <Button Content="Clear Group"
                                    Command="{Binding ClearCustomGroupCommand}" />
                        </StackPanel>
                    </Grid>

                    <Border x:Name="DiagnosticsPanel"
                            Grid.Row="3"
                            Background="{StaticResource PanelAltBrush}"
                            CornerRadius="10"
                            Padding="12"
                            Margin="0,14,0,0"
                            Visibility="{Binding IsAdvancedModeVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Diagnostics"
                                       FontWeight="SemiBold"
                                       Margin="0,0,8,8"
                                       VerticalAlignment="Center" />
                            <Button Grid.Row="0"
                                    Grid.Column="1"
                                    Content="Export Redacted Diagnostics"
                                    Command="{Binding ExportDiagnosticsCommand}"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,0,8"
                                    AutomationProperties.Name="Export Redacted Diagnostics" />
                            <Expander Grid.Row="1"
                                      Grid.ColumnSpan="2"
                                      Header="{Binding StreamHealthSummaryText}"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      Background="{StaticResource PanelAltBrush}"
                                      IsExpanded="False"
                                      Margin="0,0,0,8">
                                <StackPanel>
                                    <Button Content="Clear Stream Health"
                                            Command="{Binding ClearStreamHealthCommand}"
                                            HorizontalAlignment="Left"
                                            Margin="0,0,0,8" />
                                    <ListBox ItemsSource="{Binding StreamHealthRows}"
                                             MaxHeight="90"
                                             Background="Transparent"
                                             BorderBrush="#334056"
                                             Foreground="{StaticResource TextSecondaryBrush}"
                                             ScrollViewer.CanContentScroll="True"
                                             VirtualizingPanel.IsVirtualizing="True">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayText}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,0,0,6" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Expander>
                            <ListBox Grid.Row="2"
                                     Grid.ColumnSpan="2"
                                     ItemsSource="{Binding Diagnostics}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{StaticResource TextSecondaryBrush}"
                                     ScrollViewer.CanContentScroll="True"
                                     VirtualizingPanel.IsVirtualizing="True" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border x:Name="FooterBar"
                Grid.Row="2"
                Background="{StaticResource PanelBrush}"
                BorderBrush="#283243"
                BorderThickness="0,1,0,0">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsImporting, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ProgressBar Width="150"
                                     Height="8"
                                     Margin="0,4,10,0"
                                     IsIndeterminate="True"
                                     AutomationProperties.Name="Playlist Import Progress" />
                        <TextBlock Text="{Binding ImportProgressText}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   AutomationProperties.Name="Playlist Import Progress Text" />
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Cancel Import"
                        Command="{Binding CancelImportCommand}"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsImporting, Converter={StaticResource BooleanToVisibilityConverter}}"
                        AutomationProperties.Name="Cancel Playlist Import" />
            </Grid>
        </Border>
    </Grid>
</Window>
