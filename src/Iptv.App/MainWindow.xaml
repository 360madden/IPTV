<Window x:Class="Iptv.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="IPTV Viewer"
        Height="820"
        Width="1280"
        MinHeight="680"
        MinWidth="1040"
        Background="{StaticResource AppBackgroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="#283243"
                BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="IPTV Viewer"
                               FontSize="26"
                               FontWeight="Bold" />
                    <TextBlock Text="Content-neutral playlist viewer — import your own M3U/M3U8 sources"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="13" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="Import File"
                            Command="{Binding ImportFileCommand}" />
                    <Button Content="Load Sample"
                            Command="{Binding LoadSampleCommand}" />
                    <Button Content="Refresh"
                            Command="{Binding RefreshPlaylistCommand}" />
                    <Button Content="Import XMLTV"
                            Command="{Binding ImportEpgCommand}" />
                    <Button Content="Import URL"
                            Background="{StaticResource AccentBrush}"
                            Command="{Binding ImportUrlCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Margin="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="390" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource PanelBrush}"
                    CornerRadius="14"
                    Padding="18"
                    Margin="0,0,14,0">
                <StackPanel>
                    <TextBlock Text="Library"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Margin="0,0,0,18" />

                    <TextBlock Text="Search"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,6" />
                    <TextBox x:Name="SearchBox"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,14" />

                    <TextBlock Text="Group"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding Groups}"
                              SelectedItem="{Binding SelectedGroup}"
                              Margin="0,0,0,14"
                              Padding="8"
                              Background="{StaticResource PanelAltBrush}"
                              Foreground="Black" />

                    <TextBlock Text="Category"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding SelectedCategory}"
                              Margin="0,0,0,14"
                              Padding="8"
                              Background="{StaticResource PanelAltBrush}"
                              Foreground="Black" />

                    <CheckBox Content="Favorites only"
                              IsChecked="{Binding FavoritesOnly}"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              Margin="0,4,0,16" />

                    <Button Content="Clear Filters"
                            Command="{Binding ClearFiltersCommand}"
                            Margin="0,0,0,18" />

                    <Border Background="{StaticResource PanelAltBrush}"
                            CornerRadius="10"
                            Padding="12"
                            Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Import Summary"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6" />
                            <TextBlock Text="{Binding ImportSummaryText}"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding RefreshDiffText}"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding EpgSummaryText}"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource PanelAltBrush}"
                            CornerRadius="10"
                            Padding="12">
                        <StackPanel>
                            <TextBlock Text="Privacy"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6" />
                            <TextBlock Text="Raw stream URLs are hidden from normal UI and diagnostics. No playlists are bundled."
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Recent Import Issues"
                               FontWeight="SemiBold"
                               Margin="0,18,0,8" />
                    <ListBox ItemsSource="{Binding RecentImportIssues}"
                             MaxHeight="180"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{StaticResource TextSecondaryBrush}"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayText}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,8"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Background="{StaticResource PanelBrush}"
                    CornerRadius="14"
                    Padding="12"
                    Margin="0,0,14,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Channels"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Margin="6,4,0,12" />

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding VisibleChannels}"
                             SelectedItem="{Binding SelectedChannel}"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             MouseDoubleClick="Channels_MouseDoubleClick">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,6" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource PanelAltBrush}"
                                        CornerRadius="10"
                                        Padding="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding GroupTitle}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Category}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="12" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1"
                                                    HorizontalAlignment="Right">
                                            <Border Background="{StaticResource AccentBrush}"
                                                    CornerRadius="8"
                                                    Padding="7,3"
                                                    Margin="0,0,0,6">
                                                <Border.Visibility>
                                                    <MultiBinding Converter="{StaticResource NowPlayingVisibilityConverter}">
                                                        <Binding Path="Id" />
                                                        <Binding Path="DataContext.NowPlayingChannelId"
                                                                 RelativeSource="{RelativeSource AncestorType=Window}" />
                                                    </MultiBinding>
                                                </Border.Visibility>
                                                <TextBlock Text="NOW"
                                                           Foreground="#071018"
                                                           FontSize="11"
                                                           FontWeight="Bold" />
                                            </Border>
                                            <TextBlock Text="★"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       FontSize="18"
                                                       HorizontalAlignment="Right"
                                                       Visibility="{Binding IsFavorite, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Background="{StaticResource PanelBrush}"
                    CornerRadius="14"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="170" />
                    </Grid.RowDefinitions>

                    <Border Background="#050607"
                            CornerRadius="12"
                            ClipToBounds="True">
                        <vlc:VideoView x:Name="PlayerView" />
                    </Border>

                    <StackPanel Grid.Row="1"
                                Margin="0,14,0,10">
                        <TextBlock Text="{Binding SelectedChannel.DisplayName, FallbackValue=No channel selected}"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding PlaybackStatusText}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SelectedChannelDetails}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Play"
                                    Command="{Binding PlaySelectedCommand}" />
                            <Button Content="Pause"
                                    Command="{Binding PauseCommand}" />
                            <Button Content="Stop"
                                    Command="{Binding StopCommand}" />
                            <Button Content="Favorite"
                                    Command="{Binding ToggleFavoriteCommand}" />
                            <Button Content="Fullscreen"
                                    Click="Fullscreen_Click" />
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Buffer"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,10,0" />
                            <ComboBox Width="130"
                                      ItemsSource="{Binding BufferingPresets}"
                                      SelectedItem="{Binding SelectedBufferingPreset}"
                                      Margin="0,0,18,0"
                                      Padding="6"
                                      Foreground="Black" />
                            <TextBlock Text="Volume"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,10,0" />
                            <Slider Width="160"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="{Binding Volume, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="3"
                            Background="{StaticResource PanelAltBrush}"
                            CornerRadius="10"
                            Padding="12"
                            Margin="0,14,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Diagnostics"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8" />
                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding Diagnostics}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{StaticResource TextSecondaryBrush}"
                                     ScrollViewer.CanContentScroll="True"
                                     VirtualizingPanel.IsVirtualizing="True" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Background="{StaticResource PanelBrush}"
                BorderBrush="#283243"
                BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusText}"
                       VerticalAlignment="Center"
                       Margin="18,0"
                       Foreground="{StaticResource TextSecondaryBrush}" />
        </Border>
    </Grid>
</Window>
