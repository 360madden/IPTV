<Window x:Class="Iptv.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:persistence="clr-namespace:Iptv.Persistence;assembly=Iptv.Persistence"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="IPTV Viewer"
        Height="820"
        Width="1280"
        MinHeight="680"
        MinWidth="1040"
        Background="{StaticResource AppBackgroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Border x:Name="HeaderBar"
                Grid.Row="0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="#283243"
                BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="IPTV Viewer"
                               FontSize="26"
                               FontWeight="Bold" />
                    <TextBlock Text="Content-neutral playlist viewer — import your own M3U/M3U8 sources"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="13" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="Import File"
                            Command="{Binding ImportFileCommand}" />
                    <Button Content="Load Sample"
                            Command="{Binding LoadSampleCommand}" />
                    <Button Content="Refresh"
                            Command="{Binding RefreshPlaylistCommand}" />
                    <Button Content="Import XMLTV"
                            Command="{Binding ImportEpgCommand}" />
                    <Button Content="Import Org"
                            Command="{Binding ImportOrganizationCommand}" />
                    <Button Content="Export Org"
                            Command="{Binding ExportOrganizationCommand}" />
                    <Button Content="Import URL"
                            Background="{StaticResource AccentBrush}"
                            Command="{Binding ImportUrlCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="MainContentGrid"
              Grid.Row="1"
              Margin="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="390" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="LibraryPanel"
                    Background="{StaticResource PanelBrush}"
                    CornerRadius="14"
                    Padding="18"
                    Margin="0,0,14,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                    <TextBlock Text="Library"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Margin="0,0,0,18" />

                    <TextBlock Text="Search"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,6" />
                    <TextBox x:Name="SearchBox"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,14"
                             AutomationProperties.Name="Channel Search" />

                    <TextBlock Text="Group"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding Groups}"
                              SelectedItem="{Binding SelectedGroup}"
                              Margin="0,0,0,14"
                              Padding="8"
                              Background="{StaticResource PanelAltBrush}"
                              Foreground="Black" />

                    <TextBlock Text="Category"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding SelectedCategory}"
                              Margin="0,0,0,14"
                              Padding="8"
                              Background="{StaticResource PanelAltBrush}"
                              Foreground="Black" />

                    <CheckBox Content="Favorites only"
                              IsChecked="{Binding FavoritesOnly}"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              Margin="0,4,0,12" />

                    <TextBlock Text="Visibility"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding VisibilityFilterOptions}"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding SelectedHiddenFilter}"
                              Margin="0,0,0,14"
                              Padding="8"
                              Background="{StaticResource PanelAltBrush}"
                              Foreground="Black"
                              AutomationProperties.Name="Channel Visibility Filter" />

                    <TextBlock Text="Sort"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding SortModeOptions}"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding SelectedSortMode}"
                              Margin="0,0,0,16"
                              Padding="8"
                              Background="{StaticResource PanelAltBrush}"
                              Foreground="Black"
                              AutomationProperties.Name="Channel Sort Mode" />

                    <Button Content="Clear Filters"
                            Command="{Binding ClearFiltersCommand}"
                            Margin="0,0,0,18" />

                    <Expander Header="Channel Organization"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              Background="{StaticResource PanelAltBrush}"
                              Margin="0,0,0,14"
                              IsExpanded="True"
                              AutomationProperties.Name="Channel Organization">
                        <Border Background="{StaticResource PanelAltBrush}"
                                CornerRadius="10"
                                Padding="12"
                                Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="Custom groups"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8" />
                                <TextBlock Text="Add a group, then assign selected or batch-selected channels."
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,0,0,10" />
                                <TextBox Text="{Binding NewCustomGroupName, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,0,8"
                                         AutomationProperties.Name="New Custom Group Name" />
                                <Button Content="Add Group"
                                        Command="{Binding AddCustomGroupCommand}"
                                        Margin="0,0,0,12" />
                                <ListBox ItemsSource="{Binding CustomGroupSummaries}"
                                         SelectedValuePath="Name"
                                         SelectedValue="{Binding SelectedManagedCustomGroup}"
                                         MaxHeight="120"
                                         Background="Transparent"
                                         BorderBrush="#334056"
                                         Foreground="{StaticResource TextSecondaryBrush}"
                                         ScrollViewer.CanContentScroll="True"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         AutomationProperties.Name="Custom Group List">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel LastChildFill="True">
                                                <TextBlock Text="{Binding ChannelCount, StringFormat={}{0:N0}}"
                                                           DockPanel.Dock="Right"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           Margin="10,0,0,0" />
                                                <TextBlock Text="{Binding Name}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Text="Rename selected group"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,10,0,4" />
                                <TextBox Text="{Binding RenameCustomGroupName, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,0,8"
                                         AutomationProperties.Name="Rename Custom Group Name" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Rename"
                                            Command="{Binding RenameCustomGroupCommand}" />
                                    <Button Content="Delete"
                                            Command="{Binding DeleteCustomGroupCommand}" />
                                </StackPanel>
                                <TextBlock Text="{Binding BatchSelectionText}"
                                           FontWeight="SemiBold"
                                           Margin="0,14,0,6" />
                                <ComboBox ItemsSource="{Binding CustomGroupAssignments}"
                                          SelectedItem="{Binding SelectedBatchGroupAssignment}"
                                          Padding="6"
                                          Margin="0,0,0,8"
                                          Foreground="Black"
                                          AutomationProperties.Name="Batch Custom Group" />
                                <WrapPanel>
                                    <Button Content="Batch Favorite"
                                            Command="{Binding BatchFavoriteCommand}"
                                            Margin="0,0,8,8" />
                                    <Button Content="Batch Hide"
                                            Command="{Binding BatchHideCommand}"
                                            Margin="0,0,8,8" />
                                    <Button Content="Batch Unhide"
                                            Command="{Binding BatchUnhideCommand}"
                                            Margin="0,0,8,8" />
                                    <Button Content="Assign Group"
                                            Command="{Binding BatchAssignGroupCommand}"
                                            Margin="0,0,8,8" />
                                    <Button Content="Clear Group"
                                            Command="{Binding BatchClearGroupCommand}"
                                            Margin="0,0,8,8" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </Expander>

                    <Expander Header="UI Settings"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              Background="{StaticResource PanelAltBrush}"
                              Margin="0,0,0,14"
                              IsExpanded="False"
                              AutomationProperties.Name="UI Settings">
                        <Border Background="{StaticResource PanelAltBrush}"
                                CornerRadius="10"
                                Padding="12"
                                Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="Clock overlay"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8" />
                                <CheckBox Content="Show clock"
                                          IsChecked="{Binding Clock.IsVisible}"
                                          Foreground="{StaticResource TextPrimaryBrush}"
                                          Margin="0,0,0,6"
                                          AutomationProperties.Name="Show Clock" />
                                <CheckBox Content="Use 24-hour time"
                                          IsChecked="{Binding Clock.Use24HourClock}"
                                          Foreground="{StaticResource TextPrimaryBrush}"
                                          Margin="0,0,0,6"
                                          AutomationProperties.Name="Use 24 Hour Clock" />
                                <CheckBox Content="Show seconds"
                                          IsChecked="{Binding Clock.ShowSeconds}"
                                          Foreground="{StaticResource TextPrimaryBrush}"
                                          Margin="0,0,0,12"
                                          AutomationProperties.Name="Show Clock Seconds" />

                                <TextBlock Text="Position"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding Clock.PositionOptions}"
                                          DisplayMemberPath="Label"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding Clock.Position}"
                                          Padding="6"
                                          Margin="0,0,0,10"
                                          Foreground="Black"
                                          AutomationProperties.Name="Clock Position" />

                                <TextBlock Text="Size"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding Clock.SizeOptions}"
                                          DisplayMemberPath="Label"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding Clock.Size}"
                                          Padding="6"
                                          Margin="0,0,0,10"
                                          Foreground="Black"
                                          AutomationProperties.Name="Clock Size" />

                                <TextBlock Text="Background"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding Clock.BackgroundOptions}"
                                          DisplayMemberPath="Label"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding Clock.Background}"
                                          Padding="6"
                                          Margin="0,0,0,10"
                                          Foreground="Black"
                                          AutomationProperties.Name="Clock Background" />

                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="Opacity"
                                               DockPanel.Dock="Left"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding Clock.OverlayOpacityPercent}"
                                               DockPanel.Dock="Right"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Right" />
                                </DockPanel>
                                <Slider Minimum="0.35"
                                        Maximum="1"
                                        TickFrequency="0.05"
                                        Value="{Binding Clock.OverlayOpacity, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                        Margin="0,0,0,12"
                                        AutomationProperties.Name="Clock Opacity" />

                                <TextBlock Text="Fullscreen"
                                           FontWeight="SemiBold"
                                           Margin="0,2,0,8" />
                                <CheckBox Content="Auto-hide fullscreen controls"
                                          IsChecked="{Binding Clock.AutoHideFullscreenControls}"
                                          Foreground="{StaticResource TextPrimaryBrush}"
                                          Margin="0,0,0,8"
                                          AutomationProperties.Name="Auto Hide Fullscreen Controls" />

                                <TextBlock Text="Monitor"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding Clock.FullscreenMonitorOptions}"
                                          DisplayMemberPath="DisplayName"
                                          SelectedValuePath="Index"
                                          SelectedValue="{Binding Clock.FullscreenMonitorIndex}"
                                          Padding="6"
                                          Foreground="Black"
                                          AutomationProperties.Name="Fullscreen Monitor" />
                            </StackPanel>
                        </Border>
                    </Expander>

                    <Border Background="{StaticResource PanelAltBrush}"
                            CornerRadius="10"
                            Padding="12"
                            Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Import Summary"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6" />
                            <TextBlock Text="{Binding ImportSummaryText}"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding RefreshDiffText}"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding EpgSummaryText}"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource PanelAltBrush}"
                            CornerRadius="10"
                            Padding="12">
                        <StackPanel>
                            <TextBlock Text="Privacy"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6" />
                            <TextBlock Text="Raw stream URLs are hidden from normal UI and diagnostics. No playlists are bundled."
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Recent Import Issues"
                               FontWeight="SemiBold"
                               Margin="0,18,0,8" />
                    <ListBox ItemsSource="{Binding RecentImportIssues}"
                             MaxHeight="180"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{StaticResource TextSecondaryBrush}"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayText}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,8"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border x:Name="ChannelsPanel"
                    Grid.Column="1"
                    Background="{StaticResource PanelBrush}"
                    CornerRadius="14"
                    Padding="12"
                    Margin="0,0,14,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Channels"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Margin="6,4,0,12" />

                    <ListBox x:Name="ChannelsListBox"
                             Grid.Row="1"
                             ItemsSource="{Binding VisibleChannels}"
                             SelectedItem="{Binding SelectedChannel}"
                             SelectionMode="Extended"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             SelectionChanged="Channels_SelectionChanged"
                             MouseDoubleClick="Channels_MouseDoubleClick">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,6" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource PanelAltBrush}"
                                        CornerRadius="10"
                                        Padding="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding EffectiveGroupTitle}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Category}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="12" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1"
                                                    HorizontalAlignment="Right">
                                            <Border Background="{StaticResource AccentBrush}"
                                                    CornerRadius="8"
                                                    Padding="7,3"
                                                    Margin="0,0,0,6">
                                                <Border.Visibility>
                                                    <MultiBinding Converter="{StaticResource NowPlayingVisibilityConverter}">
                                                        <Binding Path="Id" />
                                                        <Binding Path="DataContext.NowPlayingChannelId"
                                                                 RelativeSource="{RelativeSource AncestorType=Window}" />
                                                    </MultiBinding>
                                                </Border.Visibility>
                                                <TextBlock Text="NOW"
                                                           Foreground="#071018"
                                                           FontSize="11"
                                                           FontWeight="Bold" />
                                            </Border>
                                            <TextBlock Text="★"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       FontSize="18"
                                                       HorizontalAlignment="Right"
                                                       Visibility="{Binding IsFavorite, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <Border Background="#66FFB04E"
                                                    CornerRadius="8"
                                                    Padding="7,3"
                                                    Margin="0,6,0,0"
                                                    Visibility="{Binding IsHidden, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="HIDDEN"
                                                           Foreground="#FFF7E4"
                                                           FontSize="11"
                                                           FontWeight="Bold" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border x:Name="PlayerPanel"
                    Grid.Column="2"
                    Background="{StaticResource PanelBrush}"
                    CornerRadius="14"
                    Padding="16">
                <Grid x:Name="PlayerContentGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="PlayerVideoRow"
                                       Height="*" />
                        <RowDefinition x:Name="PlayerDetailsRow"
                                       Height="Auto" />
                        <RowDefinition x:Name="PlayerControlsRow"
                                       Height="Auto" />
                        <RowDefinition x:Name="PlayerDiagnosticsRow"
                                       Height="170" />
                    </Grid.RowDefinitions>

                    <Border x:Name="PlayerVideoHost"
                            Background="#050607"
                            CornerRadius="12"
                            ClipToBounds="True">
                        <vlc:VideoView x:Name="PlayerView">
                            <Grid x:Name="PlayerOverlayGrid"
                                  Background="#01000000"
                                  MouseLeftButtonDown="PlayerOverlay_MouseLeftButtonDown"
                                  MouseMove="PlayerOverlay_MouseMove">
                                <Border Padding="{Binding Clock.OverlayPadding}"
                                        Background="{Binding Clock.OverlayBackgroundBrush}"
                                        BorderBrush="{Binding Clock.OverlayBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{Binding Clock.OverlayCornerRadius}"
                                        IsHitTestVisible="False"
                                        Opacity="{Binding Clock.OverlayOpacity}"
                                        Visibility="{Binding Clock.IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        AutomationProperties.Name="Clock Overlay">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                            <Setter Property="VerticalAlignment" Value="Top" />
                                            <Setter Property="Margin" Value="22,22,22,22" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Clock.Position}" Value="{x:Static persistence:ClockOverlayPosition.TopLeft}">
                                                    <Setter Property="HorizontalAlignment" Value="Left" />
                                                    <Setter Property="VerticalAlignment" Value="Top" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Clock.Position}" Value="{x:Static persistence:ClockOverlayPosition.BottomRight}">
                                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                                    <Setter Property="VerticalAlignment" Value="Bottom" />
                                                    <Setter Property="Margin" Value="22,22,22,118" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Clock.Position}" Value="{x:Static persistence:ClockOverlayPosition.BottomLeft}">
                                                    <Setter Property="HorizontalAlignment" Value="Left" />
                                                    <Setter Property="VerticalAlignment" Value="Bottom" />
                                                    <Setter Property="Margin" Value="22,22,22,118" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Clock.CurrentTime}"
                                               AutomationProperties.Name="{Binding Clock.CurrentTime, StringFormat=Clock Overlay {0}}"
                                               FontSize="{Binding Clock.FontSize}"
                                               FontWeight="SemiBold"
                                               Foreground="#FFFFFFFF"
                                               TextOptions.TextFormattingMode="Display"
                                               TextOptions.TextRenderingMode="ClearType" />
                                </Border>

                                <Border x:Name="FullscreenHudOverlay"
                                        VerticalAlignment="Bottom"
                                        HorizontalAlignment="Center"
                                        MaxWidth="860"
                                        Margin="24,0,24,28"
                                        Padding="18,14"
                                        Background="#D40A0E14"
                                        BorderBrush="#334EA7FF"
                                        BorderThickness="1"
                                        CornerRadius="18"
                                        Visibility="Collapsed"
                                        AutomationProperties.Name="Fullscreen Mini HUD">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SelectedChannel.DisplayName, FallbackValue=No channel selected}"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding PlaybackStatusText}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,4,0,0" />
                                            <TextBlock Text="F11 or double-click exits fullscreen · Esc restores window"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="11"
                                                       Margin="0,6,0,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                    Margin="18,0,0,0">
                                            <Button Content="Play"
                                                    Command="{Binding PlaySelectedCommand}" />
                                            <Button Content="Pause"
                                                    Command="{Binding PauseCommand}" />
                                            <Button Content="Stop"
                                                    Command="{Binding StopCommand}" />
                                            <Button Content="Exit"
                                                    Click="FullscreenExit_Click"
                                                    Background="{StaticResource AccentBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </vlc:VideoView>
                    </Border>

                    <StackPanel x:Name="PlayerDetailsPanel"
                                Grid.Row="1"
                                Margin="0,14,0,10">
                        <TextBlock Text="{Binding SelectedChannel.DisplayName, FallbackValue=No channel selected}"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding PlaybackStatusText}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SelectedChannelDetails}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid x:Name="PlayerControlsPanel"
                          Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Play"
                                    Command="{Binding PlaySelectedCommand}" />
                            <Button Content="Pause"
                                    Command="{Binding PauseCommand}" />
                            <Button Content="Stop"
                                    Command="{Binding StopCommand}" />
                            <Button Content="Favorite"
                                    Command="{Binding ToggleFavoriteCommand}" />
                            <Button Content="{Binding HideSelectedChannelLabel}"
                                    Command="{Binding ToggleHiddenCommand}" />
                            <Button Content="Up"
                                    Command="{Binding MoveChannelUpCommand}" />
                            <Button Content="Down"
                                    Command="{Binding MoveChannelDownCommand}" />
                            <CheckBox Content="Clock"
                                      IsChecked="{Binding Clock.IsVisible}"
                                      VerticalAlignment="Center"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      Margin="6,0,10,0" />
                            <CheckBox Content="24h"
                                      IsChecked="{Binding Clock.Use24HourClock}"
                                      VerticalAlignment="Center"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      Margin="0,0,10,0" />
                            <CheckBox Content="Sec"
                                      IsChecked="{Binding Clock.ShowSeconds}"
                                      VerticalAlignment="Center"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      Margin="0,0,10,0" />
                            <Button Content="Fullscreen"
                                    Click="Fullscreen_Click" />
                        </StackPanel>

                        <StackPanel Grid.Row="0"
                                    Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Buffer"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,10,0" />
                            <ComboBox Width="130"
                                      ItemsSource="{Binding BufferingPresets}"
                                      SelectedItem="{Binding SelectedBufferingPreset}"
                                      Margin="0,0,18,0"
                                      Padding="6"
                                      Foreground="Black" />
                            <TextBlock Text="Volume"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,10,0" />
                            <Slider Width="160"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="{Binding Volume, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    Grid.ColumnSpan="3"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="0,10,0,0">
                            <TextBlock Text="Selected group"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,10,0" />
                            <ComboBox Width="180"
                                      ItemsSource="{Binding CustomGroupAssignments}"
                                      SelectedItem="{Binding SelectedCustomGroupAssignment}"
                                      Padding="6"
                                      Margin="0,0,8,0"
                                      Foreground="Black"
                                      AutomationProperties.Name="Selected Channel Custom Group" />
                            <Button Content="Clear Group"
                                    Command="{Binding ClearCustomGroupCommand}" />
                        </StackPanel>
                    </Grid>

                    <Border x:Name="DiagnosticsPanel"
                            Grid.Row="3"
                            Background="{StaticResource PanelAltBrush}"
                            CornerRadius="10"
                            Padding="12"
                            Margin="0,14,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Diagnostics"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8" />
                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding Diagnostics}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{StaticResource TextSecondaryBrush}"
                                     ScrollViewer.CanContentScroll="True"
                                     VirtualizingPanel.IsVirtualizing="True" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border x:Name="FooterBar"
                Grid.Row="2"
                Background="{StaticResource PanelBrush}"
                BorderBrush="#283243"
                BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusText}"
                       VerticalAlignment="Center"
                       Margin="18,0"
                       Foreground="{StaticResource TextSecondaryBrush}" />
        </Border>
    </Grid>
</Window>
