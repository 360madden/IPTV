<Window x:Class="Iptv.App.DuplicatePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Duplicate Preview"
        Width="560"
        Height="420"
        MinWidth="480"
        MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        AutomationProperties.Name="Duplicate Preview Dialog">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{Binding TitleText}"
                       FontSize="{DynamicResource AppFontSizeLarge}"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
            <TextBlock Text="Review the duplicate entries that will be hidden. The first playlist/order entry remains visible."
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,8,0,14" />
        </StackPanel>

        <ListBox Grid.Row="1"
                 ItemsSource="{Binding PreviewLines}"
                 Background="{DynamicResource PanelAltBrush}"
                 BorderBrush="{DynamicResource ControlBorderBrush}"
                 Foreground="{DynamicResource TextPrimaryBrush}"
                 ScrollViewer.CanContentScroll="True"
                 VirtualizingPanel.IsVirtualizing="True"
                 AutomationProperties.Name="Duplicate Preview List" />

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Cancel"
                    Click="Cancel_Click" />
            <Button Content="Hide Duplicates"
                    Background="{DynamicResource AccentBrush}"
                    Foreground="{DynamicResource AccentTextBrush}"
                    Click="Hide_Click"
                    AutomationProperties.Name="Confirm Hide Duplicates" />
        </StackPanel>
    </Grid>
</Window>
